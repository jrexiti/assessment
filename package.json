{
  "name": "assessment",
  "version": "1.0.0",
  "description": "take home assessment",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js src/features/**/*.feature --require \"src/step-definitions/**/*.js\"",
    "report": "mkdir -p reports && cucumber-js src/features/**/*.feature --require \"src/step-definitions/**/*.js\" --format \"html:reports/cucumber-report-$(date +%Y-%m-%d_%H-%M-%S).html\"",
    "test:report": "mkdir -p reports && cucumber-js src/features/**/*.feature --require \"src/step-definitions/**/*.js\" --format progress --format \"html:reports/cucumber-report-$(date +%Y-%m-%d_%H-%M-%S).html\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jrexiti/assessment.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/jrexiti/assessment/issues"
  },
  "homepage": "https://github.com/jrexiti/assessment#readme",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1"
  }
}
